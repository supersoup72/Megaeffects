<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Top bar -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:background="@color/bg_card"
        android:gravity="center_vertical" android:padding="4dp">
        <Button android:id="@+id/btn_back" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Back" android:textSize="12sp"
            android:backgroundTint="@color/bg_surface"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:id="@+id/tv_title"
            android:textColor="@color/text_primary" android:textSize="15sp"
            android:textStyle="bold" android:paddingStart="8dp"/>
        <Button android:id="@+id/btn_settings" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Settings" android:textSize="11sp"
            android:backgroundTint="@color/bg_surface"/>
        <Button android:id="@+id/btn_export" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Export" android:textSize="12sp"
            android:backgroundTint="@color/accent_green" android:layout_marginStart="4dp"/>
    </LinearLayout>

    <!-- Preview -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="3" android:background="#000000">
        <ImageView android:id="@+id/preview_image" android:layout_width="match_parent"
            android:layout_height="match_parent" android:scaleType="fitCenter"
            android:visibility="gone"/>
        <TextView android:id="@+id/preview_hint" android:layout_width="match_parent"
            android:layout_height="match_parent" android:text="Tap Render to preview"
            android:textColor="@color/text_secondary" android:gravity="center"/>
    </FrameLayout>

    <!-- Playback controls -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="4dp">
        <TextView android:id="@+id/time_label" android:layout_width="52dp"
            android:layout_height="wrap_content" android:text="0.00s"
            android:textColor="@color/text_primary" android:textSize="12sp"/>
        <Button android:id="@+id/btn_rewind" android:layout_width="40dp"
            android:layout_height="36dp" android:text="|&lt;" android:textSize="11sp"
            android:backgroundTint="@color/bg_surface"/>
        <Button android:id="@+id/btn_play" android:layout_width="64dp"
            android:layout_height="36dp" android:text="Play" android:textSize="12sp"
            android:backgroundTint="@color/accent_green" android:layout_marginStart="4dp"/>
        <Button android:id="@+id/btn_render" android:layout_width="0dp"
            android:layout_height="36dp" android:layout_weight="1" android:text="Render"
            android:textSize="12sp" android:backgroundTint="@color/accent_blue"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <!-- Scrubber -->
    <SeekBar android:id="@+id/scrubber" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginHorizontal="8dp"/>

    <!-- Timeline -->
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/bg_card">
        <com.megaeffects.TimelineView android:id="@+id/timeline_view"
            android:layout_width="1200dp" android:layout_height="wrap_content"/>
    </HorizontalScrollView>

    <!-- Layers header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@color/bg_surface" android:paddingHorizontal="8dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Layers" android:textStyle="bold"
            android:textColor="@color/text_primary"/>
        <Button android:id="@+id/btn_add_layer" android:layout_width="wrap_content"
            android:layout_height="32dp" android:text="+ Layer" android:textSize="12sp"
            android:backgroundTint="@color/accent_purple"/>
    </LinearLayout>

    <!-- Layer list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/layer_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"/>

    <!-- Transform panel -->
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="2">
        <LinearLayout android:id="@+id/transform_panel"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone"
            android:background="@color/bg_card" android:padding="4dp"/>
    </ScrollView>

</LinearLayout>
